{
    "name": "jul6art/admin-bundle",
    "type": "symfony-bundle",
    "description": "Symfony admin backoffice bundle",
    "homepage": "https://github.com/jul6art/admin-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Jul6Art",
            "email": "admin@devinthehood.com",
            "homepage": "https://devinthehood.com/"
        }
    ],
    "require": {
        "php": "^8.5",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/security-core": "^7.4 || ^8.0",
        "symfony/translation-contracts": "^3.4",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.5",
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.0",
        "symfony/asset": "^7.4 || ^8.0",
        "symfony/flex": "^2.4",
        "symfony/form": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/phpunit-bridge": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/security-csrf": "^7.4 || ^8.0",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/validator": "^7.4 || ^8.0",
        "symfony/var-dumper": "^7.4 || ^8.0",
        "twig/twig": "^3.28"
    },
    "autoload": {
        "psr-4": {
            "Jul6Art\\AdminBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jul6Art\\AdminBundle\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/flex": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "symfony": {
            "require": "7.4.*"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "rector": "rector process",
        "rector-check": "rector process --dry-run",
        "test": "phpunit",
        "qa": [
            "@cs-check",
            "@rector-check",
            "@phpstan",
            "@test"
        ]
    },
    "suggest": {
        "twig/twig": "La coquille, les pages d'authentification et l'écran d'apparence. Sans Twig, il reste le contrat de navigation, les enums et le trait d'entité.",
        "symfony/form": "Le formulaire d'apparence (`AppearanceType`).",
        "doctrine/orm": "Le trait `AppearancePreferencesTrait` et le contrôleur qui l'enregistre.",
        "symfony/asset": "`asset()` pour le logo et le favicon ; sans lui, les chemins sont rendus tels quels.",
        "jul6art/datatable-bundle": "Les tableaux du back-office, et les contrôleurs Stimulus `ui--modal` / `ui--tooltip` que la coquille suppose enregistrés."
    }
}
