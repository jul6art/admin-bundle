{#
    Demande de réinitialisation. Attend `form`.

    ⚠️ La réponse ne doit jamais dire si l'adresse existe. Le contrôleur redirige vers
    `check_email.html.twig` dans les deux cas — un message différent transformerait ce formulaire
    en oracle d'énumération de comptes.
#}
{% extends '@Admin/security/_card.html.twig' %}
{% trans_default_domain 'security' %}

{% block auth_title %}{{ 'security.reset_password.request.title'|trans }}{% endblock %}
{% block auth_subtitle %}<p class="text-sm text-slate-500 dark:text-slate-400 mt-1">{{ 'security.reset_password.request.subtitle'|trans }}</p>{% endblock %}

{% block auth_body %}
    {{ form_start(form, { attr: { class: 'space-y-5' } }) }}
        {{ form_errors(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn-primary w-full justify-center">{{ 'security.reset_password.request.submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}

{% block auth_footer %}
    {% if admin_route('login') %}
        <a href="{{ path(admin_route('login')) }}" class="text-accent-600 hover:text-accent-700 dark:text-accent-400 font-medium">
            {{ 'security.reset_password.back_to_login'|trans }}
        </a>
    {% endif %}
{% endblock %}
