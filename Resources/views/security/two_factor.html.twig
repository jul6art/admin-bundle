{#
    Le code demandé après le mot de passe (`admin.two_factor`, scheb/2fa-bundle) : la même carte que
    la page de connexion. Les variables viennent du contrôleur de formulaire de scheb.

    ⚠️ `authenticationError` est une clé du domaine `SchebTwoFactorBundle` (« code_invalid »…), que
    scheb traduit lui-même ; la seule qu'il ne connaît pas est `two_factor.throttled` (la limite
    d'essais de ce bundle) — l'application l'ajoute à son catalogue `SchebTwoFactorBundle`.
#}
{% extends '@Admin/security/_card.html.twig' %}
{% trans_default_domain 'security' %}

{% block auth_title %}{{ 'security.two_factor.title'|trans }}{% endblock %}
{% block auth_subtitle %}<p class="text-sm text-slate-500 dark:text-slate-400 mt-1">{{ 'security.two_factor.subtitle'|trans }}</p>{% endblock %}

{% block auth_body %}
    {% if authenticationError %}
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900 dark:bg-red-900/20 dark:text-red-400" data-totp-error>
            {{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
        </div>
    {% endif %}

    <form method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" class="space-y-5">
        <div class="form-field">
            <label class="form-label" for="_auth_code">{{ 'security.two_factor.code'|trans }}</label>
            <input class="form-control tracking-widest text-center" id="_auth_code" type="text" name="{{ authCodeParameterName }}"
                   autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]*" maxlength="6" required autofocus>
        </div>
        {% if isCsrfProtectionEnabled %}
            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
        {% endif %}
        <button type="submit" class="btn-primary w-full justify-center">
            <i class="fa-solid fa-right-to-bracket"></i> {{ 'security.two_factor.submit'|trans }}
        </button>
    </form>

    {#
        Le code de secours (`admin.two_factor.backup_codes`) : un second formulaire, replié — le champ
        du haut garde son clavier numérique, celui-ci accepte des lettres. Même nom de champ, même
        chemin de contrôle : scheb essaie le code de secours avant le code TOTP.
    #}
    {% if admin_two_factor_backup_codes() %}
        <details class="mt-4 text-sm" data-totp-backup>
            <summary class="cursor-pointer text-center text-slate-500 hover:text-slate-700 dark:text-slate-400">{{ 'security.two_factor.backup.login_toggle'|trans }}</summary>
            <p class="mt-3 text-slate-500 dark:text-slate-400">{{ 'security.two_factor.backup.login_help'|trans }}</p>
            <form method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" class="space-y-3 mt-3">
                <div class="form-field">
                    <label class="form-label" for="_auth_backup_code">{{ 'security.two_factor.backup.login_label'|trans }}</label>
                    <input class="form-control tracking-widest text-center uppercase" id="_auth_backup_code" type="text" name="{{ authCodeParameterName }}"
                           autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="11" required>
                </div>
                {% if isCsrfProtectionEnabled %}
                    <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
                {% endif %}
                <button type="submit" class="btn-secondary w-full justify-center">{{ 'security.two_factor.backup.login_submit'|trans }}</button>
            </form>
        </details>
    {% endif %}

    <p class="mt-4 text-center text-sm">
        <a href="{{ logoutPath }}" class="text-slate-500 hover:text-slate-700 dark:text-slate-400">{{ 'security.two_factor.cancel'|trans }}</a>
    </p>
{% endblock %}
