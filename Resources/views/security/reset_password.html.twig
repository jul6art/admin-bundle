{# Saisie du nouveau mot de passe, après avoir suivi le lien reçu. Attend `form`. #}
{% extends '@Admin/security/_card.html.twig' %}
{% trans_default_domain 'security' %}

{% block auth_title %}{{ 'security.reset_password.reset.title'|trans }}{% endblock %}
{% block auth_subtitle %}<p class="text-sm text-slate-500 dark:text-slate-400 mt-1">{{ 'security.reset_password.reset.subtitle'|trans }}</p>{% endblock %}

{% block auth_body %}
    {{ form_start(form, { attr: { class: 'space-y-5' } }) }}
        {{ form_errors(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn-primary w-full justify-center">{{ 'security.reset_password.reset.submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
