{#
    La double authentification de son compte (`admin.two_factor`) : activée, ou à activer par un QR
    code et un premier code juste ; désactivable par un code en cours, sauf quand l'application
    l'impose (`required`) — l'écran le dit, et `TwoFactorEnforcementListener` y ramène tant qu'elle
    n'est pas active.

    Attend `account`, `form` (null quand il n'y a rien à faire), `required`, `qr_code`, `secret`, et
    `layout` : celui de l'espace qui a importé l'écran sous son préfixe (`_admin_layout`), sinon null.

    Les codes de secours (`admin.two_factor.backup_codes`) : `backup_codes` (proposés à ce compte),
    `backup_form` (les régénérer), `backup_codes_left`, `few_backup_codes` (le seuil d'alerte) et
    `new_backup_codes` — les codes tirés à la requête précédente, montrés UNE fois : ils ne sont stockés
    qu'en empreintes.

    ⚠️ `admin_layout_template()` par défaut, jamais `'@Admin/layout.html.twig'` en dur — voir l'écran
    d'apparence pour le symptôme.

    ⚠️ Le QR code est un SVG en URI `data:` (aucune ressource externe, CSP `img-src 'self' data:`), et
    le secret n'est montré QUE pendant l'enrôlement.

    Les libellés sont les clés `security.two_factor.*` du catalogue `security` de l'application.
#}
{% extends layout ?? admin_layout_template() %}
{% trans_default_domain 'security' %}

{% block title %}{{ 'security.two_factor.page_title'|trans }} · {{ admin_branding().name }}{% endblock %}

{% block content %}
    <div class="max-w-2xl">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">{{ 'security.two_factor.page_title'|trans }}</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">{{ 'security.two_factor.help'|trans }}</p>

        {% if required and not account.totpAuthenticationEnabled %}
            <div class="panel p-4 mb-6 text-sm text-amber-700 dark:text-amber-400" data-totp-required>
                <i class="fa-solid fa-triangle-exclamation"></i> {{ 'security.two_factor.required'|trans }}
            </div>
        {% endif %}

        {% if account.totpAuthenticationEnabled %}
            <div class="panel p-6">
                <p class="text-sm text-emerald-700 dark:text-emerald-400" data-totp-enabled>
                    <i class="fa-solid fa-shield-halved"></i> {{ 'security.two_factor.enabled_since'|trans({'%date%': account.totpEnabledAt|date('d/m/Y H:i')}) }}
                </p>
                {% if form %}
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-4">{{ 'security.two_factor.disable_help'|trans }}</p>
                    {{ form_start(form, { attr: { class: 'form-grid mt-2' } }) }}
                        {{ form_errors(form) }}
                        {{ form_widget(form) }}
                        <div class="form-actions">
                            <button type="submit" class="btn-warning"><i class="fa-solid fa-ban"></i> {{ 'security.two_factor.disable'|trans }}</button>
                        </div>
                    {{ form_end(form) }}
                {% else %}
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">{{ 'security.two_factor.cannot_disable'|trans }}</p>
                {% endif %}
            </div>

            {% if backup_codes %}
                <div class="panel p-6 mt-6" data-backup-codes>
                    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{{ 'security.two_factor.backup.title'|trans }}</h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">{{ 'security.two_factor.backup.help'|trans }}</p>

                    {% if new_backup_codes is not empty %}
                        <p class="text-sm font-medium text-amber-700 dark:text-amber-400 mt-4" role="alert">
                            <i class="fa-solid fa-triangle-exclamation"></i> {{ 'security.two_factor.backup.save_now'|trans }}
                        </p>
                        {# Un bloc sélectionnable d'un geste, une grille de deux colonnes : on les copie, on les imprime. #}
                        <ol class="grid grid-cols-2 gap-x-6 gap-y-1 font-mono text-base mt-3 p-4 rounded-lg bg-slate-50 dark:bg-slate-900 select-all" data-new-backup-codes>
                            {% for code in new_backup_codes %}
                                <li>{{ code }}</li>
                            {% endfor %}
                        </ol>
                    {% elseif backup_codes_left == 0 %}
                        <p class="text-sm text-amber-700 dark:text-amber-400 mt-4" data-backup-codes-left="0">{{ 'security.two_factor.backup.none'|trans }}</p>
                    {% else %}
                        <p class="text-sm mt-4 {{ backup_codes_left <= few_backup_codes ? 'text-amber-700 dark:text-amber-400' : 'text-slate-600 dark:text-slate-300' }}" data-backup-codes-left="{{ backup_codes_left }}">
                            {{ 'security.two_factor.backup.left'|trans({'%count%': backup_codes_left}) }}
                            {% if backup_codes_left <= few_backup_codes %}{{ 'security.two_factor.backup.few_left'|trans }}{% endif %}
                        </p>
                    {% endif %}

                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-4">{{ 'security.two_factor.backup.generate_help'|trans }}</p>
                    {{ form_start(backup_form, { attr: { class: 'form-grid mt-2' } }) }}
                        {{ form_errors(backup_form) }}
                        {{ form_widget(backup_form) }}
                        <div class="form-actions">
                            <button type="submit" class="btn-secondary"><i class="fa-solid fa-rotate"></i> {{ 'security.two_factor.backup.generate'|trans }}</button>
                        </div>
                    {{ form_end(backup_form) }}
                </div>
            {% endif %}
        {% else %}
            <div class="form-panel">
                <ol class="list-decimal list-inside text-sm text-slate-600 dark:text-slate-300 space-y-1 mb-4">
                    <li>{{ 'security.two_factor.step_scan'|trans }}</li>
                    <li>{{ 'security.two_factor.step_confirm'|trans }}</li>
                </ol>
                <div class="flex flex-col sm:flex-row gap-6 items-start mb-4">
                    <img src="{{ qr_code }}" alt="{{ 'security.two_factor.qr_alt'|trans }}" width="220" height="220" class="rounded-lg border border-slate-200 bg-white" data-totp-qr>
                    <div class="text-sm">
                        <p class="text-slate-500 dark:text-slate-400">{{ 'security.two_factor.manual'|trans }}</p>
                        {# `break-words` et non `break-all` : la clé vient en groupes de quatre séparés par des espaces,
                           la ligne se coupe entre deux groupes — jamais au milieu d'un. #}
                        <p class="font-mono text-base mt-1 break-words select-all" data-totp-secret>{{ secret }}</p>
                    </div>
                </div>
                {{ form_start(form, { attr: { class: 'form-grid' } }) }}
                    {{ form_errors(form) }}
                    {{ form_widget(form) }}
                    <div class="form-actions">
                        <button type="submit" class="btn-success">
                            <i class="fa-solid fa-circle-check"></i> {{ 'security.two_factor.enable'|trans }}
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        {% endif %}
    </div>
{% endblock %}
